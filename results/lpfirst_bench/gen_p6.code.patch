+
     # --- step 2: the restricted master as a MIP
     if math.isfinite(rmp) and opts.rmp_mip_time > 0:
         cut = ub - step + 1e-7 * max(1.0, abs(ub)) if math.isfinite(ub) else GRB.INFINITY
