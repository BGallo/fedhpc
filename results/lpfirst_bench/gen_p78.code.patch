diff --git a/src/fedhpc/lp_backend.py b/src/fedhpc/lp_backend.py
new file mode 100644
index 0000000..a7a8f82
--- /dev/null
+++ b/src/fedhpc/lp_backend.py
@@ -0,0 +1,228 @@
+"""LP/MIP backends for :mod:`fedhpc.lpfirst`'s restricted masters and
+placement MIPs: Gurobi (default) and HiGHS (``highspy``, licence-free).
+
+The interface is the little column generation needs: rows with bounds,
+columns added in batches as CSC slices, an LP solve with row duals, and a
+MIP solve with a time limit, an objective cutoff, an absolute gap and a
+(partial) start. Statuses are normalised to ``"optimal"``, ``"infeasible"``
+(also: nothing below the cutoff), ``"limit"`` and ``"other"``.
+
+Sign convention: row duals are those of ``min c x``: a binding ``<=`` row has
+a dual ``<= 0``, as Gurobi's ``Pi`` (HiGHS's ``row_dual`` agrees; checked in
+``tests/test_lp_backend.py``).
+"""
+from __future__ import annotations
+
+import math
+
+import numpy as np
+
+INF = math.inf
+
+
+def make(name: str, threads: int = 0):
+    if name == "gurobi":
+        return GurobiBackend(threads)
+    if name == "highs":
+        return HighsBackend(threads)
+    raise ValueError(f"unknown LP backend {name!r} (gurobi, highs)")
+
+
+def available(name: str) -> bool:
+    try:
+        if name == "gurobi":
+            import gurobipy  # noqa: F401
+        elif name == "highs":
+            import highspy  # noqa: F401
+        else:
+            return False
+    except ImportError:
+        return False
+    return True
+
+
+class GurobiBackend:
+    name = "gurobi"
+
+    def __init__(self, threads: int = 0):
+        import gurobipy as gp
+        from . import formulations
+        self.gp = gp
+        from gurobipy import GRB
+        self.GRB = GRB
+        formulations.configure_env()
+        self.m = gp.Model("lpfirst", env=formulations._shared_env)
+        self.m.setParam("OutputFlag", 0)
+        if threads:
+            self.m.setParam("Threads", threads)
+        self.rows: list = []
+        self.cols: list = []
+
+    def add_rows(self, lo: np.ndarray, hi: np.ndarray) -> np.ndarray:
+        gp, m = self.gp, self.m
+        start = len(self.rows)
+        for a, b in zip(lo.tolist(), hi.tolist()):
+            if a == b:
+                self.rows.append(m.addConstr(gp.LinExpr() == a))
+            elif a == -INF:
+                self.rows.append(m.addConstr(gp.LinExpr() <= b))
+            else:
+                self.rows.append(m.addConstr(gp.LinExpr() >= a))
+        m.update()
+        return np.arange(start, len(self.rows))
+
+    def add_cols(self, cost, ub, integer, starts, index, value) -> None:
+        gp, GRB, m, rows = self.gp, self.GRB, self.m, self.rows
+        cost, ub, integer = cost.tolist(), ub.tolist(), np.asarray(integer).tolist()
+        starts, index, value = starts.tolist(), index.tolist(), value.tolist()
+        for c in range(len(cost)):
+            lo, hi = starts[c], starts[c + 1]
+            col = gp.Column(value[lo:hi], [rows[r] for r in index[lo:hi]])
+            self.cols.append(m.addVar(obj=cost[c], ub=ub[c],
+                                      vtype=GRB.INTEGER if integer[c] else GRB.CONTINUOUS,
+                                      column=col))
+
+    def change_costs(self, idx: np.ndarray, cost: np.ndarray) -> None:
+        for i, c in zip(idx.tolist(), cost.tolist()):
+            self.cols[i].Obj = c
+
+    def solve_lp(self) -> str:
+        self.m.optimize()
+        return "optimal" if self.m.Status == self.GRB.OPTIMAL else "other"
+
+    def solve_mip(self, *, time_limit, cutoff, gap_abs, int_tol=1e-9, focus=0,
+                  start: dict[int, float] | None = None) -> str:
+        m, GRB = self.m, self.GRB
+        m.setParam("TimeLimit", max(0.0, time_limit))
+        if math.isfinite(cutoff):
+            m.setParam("Cutoff", cutoff)
+        m.setParam("MIPGap", 0.0)
+        m.setParam("MIPGapAbs", gap_abs)
+        m.setParam("IntFeasTol", int_tol)
+        if focus:
+            m.setParam("MIPFocus", focus)
+        for c, v in (start or {}).items():
+            self.cols[c].Start = v
+        m.optimize()
+        if m.Status in (GRB.CUTOFF, GRB.INFEASIBLE) or (m.Status == GRB.OPTIMAL and m.SolCount == 0):
+            return "infeasible"
+        if m.Status == GRB.OPTIMAL:
+            return "optimal"
+        return "limit"
+
+    def has_solution(self) -> bool:
+        return self.m.SolCount > 0
+
+    def objective(self) -> float:
+        return self.m.ObjVal
+
+    def col_values(self) -> np.ndarray:
+        return np.array(self.m.getAttr("X", self.cols)) if self.cols else np.zeros(0)
+
+    def row_duals(self) -> np.ndarray:
+        return np.array(self.m.getAttr("Pi", self.rows)) if self.rows else np.zeros(0)
+
+    def write(self, path: str) -> None:
+        self.m.write(path)
+
+
+class HighsBackend:
+    name = "highs"
+
+    def __init__(self, threads: int = 0):
+        import highspy
+        self.hs = highspy
+        h = self.h = highspy.Highs()
+        h.setOptionValue("output_flag", False)
+        if threads:
+            h.setOptionValue("threads", int(threads))
+        self.n_rows = 0
+        self.n_cols = 0
+        self.integer = False
+
+    def add_rows(self, lo: np.ndarray, hi: np.ndarray) -> np.ndarray:
+        n = len(lo)
+        lo = np.where(np.isfinite(lo), lo, -self.hs.kHighsInf).astype(float)
+        hi = np.where(np.isfinite(hi), hi, self.hs.kHighsInf).astype(float)
+        self.h.addRows(n, lo, hi, 0, np.zeros(n, dtype=np.int32), np.zeros(0, dtype=np.int32),
+                       np.zeros(0))
+        start = self.n_rows
+        self.n_rows += n
+        return np.arange(start, self.n_rows)
+
+    def add_cols(self, cost, ub, integer, starts, index, value) -> None:
+        n = len(cost)
+        if not n:
+            return
+        self.h.addCols(n, np.asarray(cost, float), np.zeros(n), np.asarray(ub, float),
+                       int(starts[-1]), np.asarray(starts[:-1], dtype=np.int32),
+                       np.asarray(index, dtype=np.int32), np.asarray(value, float))
+        integer = np.asarray(integer, dtype=bool)
+        if integer.any():
+            idx = (self.n_cols + np.nonzero(integer)[0]).astype(np.int32)
+            kinds = np.array([self.hs.HighsVarType.kInteger] * len(idx))
+            self.h.changeColsIntegrality(len(idx), idx, kinds)
+            self.integer = True
+        self.n_cols += n
+
+    def change_costs(self, idx: np.ndarray, cost: np.ndarray) -> None:
+        self.h.changeColsCost(len(idx), np.asarray(idx, dtype=np.int32), np.asarray(cost, float))
+
+    def _status(self) -> str:
+        S = self.hs.HighsModelStatus
+        st = self.h.getModelStatus()
+        if st == S.kOptimal:
+            return "optimal"
+        if st in (S.kInfeasible, S.kObjectiveBound, S.kObjectiveTarget):
+            return "infeasible"
+        if st in (S.kTimeLimit, S.kIterationLimit, S.kSolutionLimit, S.kInterrupt):
+            return "limit"
+        return "other"
+
+    def solve_lp(self) -> str:
+        self.h.setOptionValue("solver", "simplex")
+        self.h.run()
+        st = self._status()
+        self.last_status = self.h.modelStatusToString(self.h.getModelStatus())
+        return "optimal" if st == "optimal" else "other"
+
+    def solve_mip(self, *, time_limit, cutoff, gap_abs, int_tol=1e-9, focus=0,
+                  start: dict[int, float] | None = None) -> str:
+        h = self.h
+        h.setOptionValue("time_limit", float(max(0.0, time_limit)))
+        h.setOptionValue("mip_rel_gap", 0.0)
+        h.setOptionValue("mip_abs_gap", float(gap_abs))
+        # HiGHS's integrality tolerance floor is looser than Gurobi's; the
+        # caller re-checks every schedule it extracts.
+        h.setOptionValue("mip_feasibility_tolerance", float(max(int_tol, 1e-7)))
+        if math.isfinite(cutoff):
+            h.setOptionValue("objective_bound", float(cutoff))
+        if start:
+            idx = np.array(sorted(start), dtype=np.int32)
+            val = np.array([start[i] for i in idx.tolist()], dtype=float)
+            try:
+                h.setSolution(len(idx), idx, val)      # sparse start (HiGHS >= 1.8)
+            except TypeError:
+                pass
+        h.run()
+        st = self._status()
+        if st == "optimal" and not self.has_solution():
+            return "infeasible"
+        return st
+
+    def has_solution(self) -> bool:
+        info = self.h.getInfo()
+        return bool(info.primal_solution_status == 2) or (
+            self.integer and info.mip_node_count >= 0 and info.primal_solution_status != 0)
+
+    def objective(self) -> float:
+        return self.h.getInfo().objective_function_value
+
+    def col_values(self) -> np.ndarray:
+        return np.asarray(self.h.getSolution().col_value, dtype=float)
+
+    def row_duals(self) -> np.ndarray:
+        return np.asarray(self.h.getSolution().row_dual, dtype=float)
+
+    def write(self, path: str) -> None:
+        self.h.writeModel(path)
diff --git a/scripts/lpfirst_generated.py b/scripts/lpfirst_generated.py
new file mode 100644
index 0000000..813c04f
--- /dev/null
+++ b/scripts/lpfirst_generated.py
@@ -0,0 +1,199 @@
+"""lpfirst on the 108 generated instances, against the compact Gurobi results
+of ``results/generated_bench/bench_io_noreduc.jsonl`` (BPC plan, Phase 6).
+
+    uv run python scripts/lpfirst_generated.py run --label p6 --workers 3 --threads 4
+    uv run python scripts/lpfirst_generated.py run --label p6 B_pos_n100_lE_iM
+    uv run python scripts/lpfirst_generated.py summary p6
+
+Per instance: lex (f1, f2), lex (f2, f1) and, on non-trivial instances, the
+weighted sums at λ = 0.25 / 0.5 / 0.75 with Gurobi's own reference points
+(f1_T, f2_T, f1_0) and the same Pareto box (f1 <= f1_0, f2 <= f2_T), so ĝ is
+comparable. Every phase gets ``--time-limit`` seconds (Gurobi had 600).
+
+A solve is ``ok`` when both prove the same value (lex: f1 and f2; weighted:
+ĝ within 1e-6 relative), or lpfirst proves what Gurobi did not. ``better``
+marks a proof Gurobi lacked. Results: ``results/lpfirst_bench/gen_<label>.jsonl``.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+import time
+from concurrent.futures import ProcessPoolExecutor, as_completed
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+OUT = ROOT / "results" / "lpfirst_bench"
+REF = ROOT / "results" / "generated_bench" / "bench_io_noreduc.jsonl"
+LAMS = (0.25, 0.5, 0.75)
+
+
+def _phase(inst, ti, w1, w2, b1, b2, seeds, opts, limit):
+    from fedhpc import lpfirst
+    st: dict = {}
+    t = time.perf_counter()
+    res = lpfirst.solve_lpfirst(inst, w1, w2, b1, b2, time_limit=limit, options=opts, ti=ti,
+                                seed_schedules=seeds, stats=st)
+    st["wall_s"] = time.perf_counter() - t
+    st["how"] = res.how
+    return res, {k: v for k, v in st.items() if isinstance(v, (int, float, str))}
+
+
+def _f(inst, a):
+    completion = {jid: t + inst.p_occ[jid, mid] for jid, (mid, t) in a.items()}
+    return inst.f1_of(completion), inst.f2_of(a)
+
+
+def run_one(name: str, ref: dict, threads: int, limit: float, opts_kw: dict) -> dict:
+    from fedhpc import bpc, instance_gen, lpfirst
+    from fedhpc.formulations import configure_env
+    from fedhpc.model import weighted_sum_degenerate, weighted_sum_terms
+    configure_env()
+    opts = lpfirst.LPFirstOptions(mip_threads=threads, lp_threads=threads, **opts_kw)
+    t0 = time.perf_counter()
+    inst = instance_gen.build(name)
+    ti = lpfirst._TI(inst, bpc._prepare(inst))
+    seeds = lpfirst.seed_schedules(inst, ti) if hasattr(lpfirst, "seed_schedules") \
+        else bpc.heuristic_schedules(inst)
+    rec = {"name": name, "build_s": time.perf_counter() - t0, "solves": {}}
+
+    def lex(primary):
+        w = (1.0, 0.0) if primary == "f1" else (0.0, 1.0)
+        t = time.perf_counter()
+        r1, s1 = _phase(inst, ti, *w, None, None, seeds, opts, limit)
+        out = {"phase1": s1}
+        if r1.status == "optimal":
+            f1, f2 = _f(inst, r1.assignment)
+            b1, b2 = (f1, None) if primary == "f1" else (None, f2)
+            r2, s2 = _phase(inst, ti, *w[::-1], b1, b2, [r1.assignment, *seeds], opts, limit)
+            out["phase2"] = s2
+            a = r2.assignment or r1.assignment
+            status = r2.status
+        else:
+            a, status = r1.assignment, "feasible" if r1.assignment else "none"
+        if a:
+            seeds.insert(0, a)
+            out["f1"], out["f2"] = _f(inst, a)
+        out["status"] = status
+        out["t"] = time.perf_counter() - t
+        g = ref[f"lex_{primary}"]
+        out["gurobi"] = {"status": g["status"], "f1": g["f1"], "f2": g["f2"], "t": g["t"]}
+        both = status == g["status"] == "optimal"
+        same = a is not None and abs(out["f1"] - g["f1"]) < 1e-4 and abs(out["f2"] - g["f2"]) < 1e-4
+        out["ok"] = (both and same) or (status == "optimal" and g["status"] != "optimal") \
+            or (status != "optimal")
+        out["better"] = status == "optimal" and g["status"] != "optimal"
+        out["agree"] = same if both else None
+        return out
+
+    rec["solves"]["lex_f1"] = lex("f1")
+    rec["solves"]["lex_f2"] = lex("f2")
+    f1_T, f2_T, f1_0 = ref["lex_f1"]["f1"], ref["lex_f1"]["f2"], ref["lex_f2"]["f1"]
+    if not weighted_sum_degenerate(f1_T, f2_T, f1_0, 0.0):
+        for lam in LAMS:
+            w1, w2, c = weighted_sum_terms(lam, f1_T, f2_T, f1_0, 0.0)
+            t = time.perf_counter()
+            r, s = _phase(inst, ti, w1, w2, f1_0, f2_T, seeds, opts, limit)
+            out = {"phase1": s, "status": r.status, "t": time.perf_counter() - t}
+            if r.assignment:
+                seeds.insert(0, r.assignment)
+                out["f1"], out["f2"] = _f(inst, r.assignment)
+                out["g"] = w1 * out["f1"] + w2 * out["f2"] + c
+            out["bound_g"] = r.bound + c
+            g = ref["lams"][str(lam)]["gurobi"]
+            out["gurobi"] = {k: g[k] for k in ("status", "f1", "f2", "g", "t")}
+            both = r.status == g["status"] == "optimal"
+            same = "g" in out and abs(out["g"] - g["g"]) <= 1e-6 * max(1.0, abs(g["g"]))
+            out["ok"] = (both and same) or r.status != "optimal" or g["status"] != "optimal"
+            if r.status == "optimal" and g["status"] != "optimal":
+                out["ok"] = "g" in out and out["g"] <= g["g"] + 1e-6
+            out["better"] = r.status == "optimal" and g["status"] != "optimal"
+            out["agree"] = same if both else None
+            rec["solves"][f"ws_{lam}"] = out
+    rec["t"] = time.perf_counter() - t0
+    return rec
+
+
+def run(args) -> None:
+    OUT.mkdir(parents=True, exist_ok=True)
+    out = OUT / f"gen_{args.label}.jsonl"
+    refs = {(r := json.loads(l))["name"]: r for l in REF.read_text().splitlines() if l.strip()}
+    names = args.names or sorted(refs)
+    done = set()
+    if out.exists():
+        done = {json.loads(l)["name"] for l in out.read_text().splitlines() if l.strip()}
+    todo = [n for n in names if n not in done]
+    todo.sort(key=lambda n: (("pos" not in n), not n.startswith("B"), n))
+    opts_kw = json.loads(args.options) if args.options else {}
+    print(f"{len(todo)} to run ({len(done)} already in {out.name})", flush=True)
+    with ProcessPoolExecutor(args.workers) as ex, out.open("a") as f:
+        futs = {ex.submit(run_one, n, refs[n], args.threads, args.time_limit, opts_kw): n
+                for n in todo}
+        for k, fut in enumerate(as_completed(futs), 1):
+            n = futs[fut]
+            try:
+                rec = fut.result()
+            except Exception as e:  # noqa: BLE001
+                print(f"[{k}/{len(todo)}] {n} FAILED {type(e).__name__}: {e}", flush=True)
+                continue
+            rec["label"] = args.label
+            f.write(json.dumps(rec) + "\n")
+            f.flush()
+            s = rec["solves"]
+            print(f"[{k}/{len(todo)}] {n} {rec['t']:.0f}s "
+                  + " ".join(f"{key}:{v['status'][:3]}{'' if v['ok'] else '!DIFF'}"
+                             f"{'+' if v['better'] else ''}" for key, v in s.items()), flush=True)
+
+
+def summary(args) -> None:
+    for label in args.labels:
+        rows = [json.loads(l) for l in (OUT / f"gen_{label}.jsonl").read_text().splitlines()
+                if l.strip()]
+        n = proven = better = diff = 0
+        lp_t = gu_t = 0.0
+        unproven, slow = [], []
+        for r in rows:
+            for key, v in r["solves"].items():
+                n += 1
+                lp_t += v["t"]
+                gu_t += v["gurobi"]["t"]
+                proven += v["status"] == "optimal"
+                better += bool(v["better"])
+                if not v["ok"]:
+                    diff += 1
+                    print(f"  DIFF {r['name']} {key}: lp {v.get('f1')},{v.get('f2')} "
+                          f"gurobi {v['gurobi']['f1']},{v['gurobi']['f2']}")
+                if v["status"] != "optimal":
+                    unproven.append(f"{r['name']}:{key}")
+                slow.append((v["t"], f"{r['name']}:{key}", v["gurobi"]["t"], v["gurobi"]["status"]))
+        print(f"{label}: {len(rows)} instances, {n} solves; lpfirst proved {proven} "
+              f"({better} that Gurobi did not) in {lp_t:.0f} s; Gurobi {gu_t:.0f} s; "
+              f"disagreements {diff}")
+        if unproven:
+            print("  unproven:", " ".join(unproven))
+        print("  slowest lpfirst solves (lp s, gurobi s):")
+        for t, key, gt, gs in sorted(slow, reverse=True)[:args.top]:
+            print(f"    {key:32s} {t:7.1f}  {gt:7.1f} {gs}")
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser()
